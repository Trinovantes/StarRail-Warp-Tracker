{
    "type": "module",
    "version": "0.4.9",
    "appId": "ca.stephenli.starrail-warp-tracker",
    "name": "starrail-warp-tracker",
    "productName": "StarRail Warp Tracker",
    "description": "Windows application to track and backup your Honkai StarRail warp history",
    "homepage": "https://github.com/Trinovantes/StarRail-Warp-Tracker",
    "author": {
        "name": "Stephen Li",
        "email": "hello@stephenli.ca",
        "url": "https://www.stephenli.ca"
    },
    "private": true,
    "main": "./dist/main.cjs",
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "dev": "  cross-env NODE_ENV=development node ./build/runDev.ts",
        "build": "cross-env NODE_ENV=production  node ./build/runBuild.ts",
        "download": "  cross-env ELECTRON_RUN_AS_NODE=1 electron --import=./build/preload.ts ./src/scripts/downloadAssets.ts",
        "fetchWarps": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import=./build/preload.ts ./src/scripts/fetchWarps.ts",
        "unit": "      cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
        "lint": "vue-tsc && eslint",
        "test": "pnpm unit"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sinclair/typebox": "^0.34.52",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/csp-html-webpack-plugin": "^5.1.0",
        "@types/node": "^26.6.6",
        "@types/source-map-support": "^0.5.10",
        "@types/webpack-env": "^1.18.8",
        "@vueuse/core": "^15.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "csp-html-webpack-plugin": "^5.1.0",
        "css-loader": "^7.1.5",
        "date-fns": "^4.4.0",
        "dotenv": "^18.0.10",
        "drizzle-orm": "^0.45.4",
        "electron": "^45.3.0",
        "electron-builder": "26.18.0",
        "electron-builder-squirrel-windows": "^26.18.0",
        "electron-cfg": "^1.2.7",
        "electron-context-menu": "^5.1.0",
        "electron-log": "^5.4.4",
        "electron-updater": "^6.8.11",
        "esbuild-loader": "^4.5.0",
        "eslint": "^10.14.0",
        "eslint-plugin-n": "^18.5.0",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "html-webpack-plugin": "^5.6.8",
        "material-design-icons-iconfont": "^6.7.0",
        "mini-css-extract-plugin": "^2.10.2",
        "node-gyp": "^13.1.0",
        "node-loader": "^2.1.0",
        "office-ui-fabric-core": "^11.1.0",
        "pinia": "^4.1.0",
        "quasar": "^2.35.3",
        "quasar-unused-plugin": "^0.3.11",
        "responsive-loader": "^3.1.2",
        "sass": "^1.108.2",
