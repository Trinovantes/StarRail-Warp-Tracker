        "sharp": "^0.35.5",
        "source-map-support": "^0.5.21",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.72.2",
        "upath": "^3.0.8",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "vue": "^3.5.45",
        "vue-eslint-parser": "^10.4.2",
        "vue-loader": "^17.4.2",
        "vue-router": "^5.5.0",
        "vue-tsc": "^3.3.14",
